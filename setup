#!/bin/bash
set -e

if ! command -v git >/dev/null 2>&1; then
    echo "git is required but was not found in PATH"
    exit 1
fi

if ! command -v brew >/dev/null 2>&1; then
    echo "Homebrew is required but was not found in PATH"
    exit 1
fi

echo "Checking if dotfiles are in the right path (~/dotfiles)"

# Set up onetime links for all of the files
DOTFILES_REPO_PATH="$HOME/dotfiles"
if [ ! -d "$DOTFILES_REPO_PATH" ]; then
    echo "dotfiles don't exist at $DOTFILES_REPO_PATH"
    exit 1
fi

echo "Installing minimal set of dependencies"
# Install the required dependencies
brew install stow
brew install zsh

echo "Stowing the files in the dotfiles directory to one above aka $HOME"
stow .

# Using the zsh installed by Homebrew
sudo dscl . -create /Users/$USER UserShell $(brew --prefix)/bin/zsh

echo "Copying relevant ssh config"
mkdir -p "$HOME/.ssh"
if [ -f "$HOME/.ssh/config" ] && ! cmp -s "$DOTFILES_REPO_PATH/ssh/config" "$HOME/.ssh/config"; then
    cp "$HOME/.ssh/config" "$HOME/.ssh/config.$(date +%Y%m%d%H%M%S).bak"
fi
cp "$DOTFILES_REPO_PATH/ssh/config" "$HOME/.ssh/config"

echo "Installing software"
brew bundle -v 2>&1 >/dev/null

## Clone tpm
if [ ! -d "$HOME/.tmux/plugins/tpm" ]; then
   git clone https://github.com/tmux-plugins/tpm "$HOME/.tmux/plugins/tpm"
fi

if git -C "$DOTFILES_REPO_PATH" rev-parse --is-inside-work-tree >/dev/null 2>&1 &&
   [ "$(git -C "$DOTFILES_REPO_PATH" rev-parse --show-toplevel)" = "$DOTFILES_REPO_PATH" ] &&
   git -C "$DOTFILES_REPO_PATH" remote get-url origin >/dev/null 2>&1; then
    git -C "$DOTFILES_REPO_PATH" remote set-url origin git@github.com:saphal1998/dotfiles.git
fi
